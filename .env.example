# Acesso ao SQL Server do blog.
#
# Nao existe senha aqui: a instancia aceita apenas autenticacao Windows, e a
# conexao usa a identidade do processo. Em producao, conceda acesso ao banco
# para a conta de servico do pool do IIS.
#
# Copie para `.env.local` (ignorado pelo git) para desenvolvimento.
SQLSERVER_SERVER=localhost
SQLSERVER_DATABASE=notpaperBlog
SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Token que a ingestao do blog exige no cabecalho X-Ingestao-Token.
# Este SIM e segredo: nunca versionar o valor real.
BLOG_INGESTAO_TOKEN=7f4c9a2e81d64b0f93c7e5a1d8b62f04c9e713ab56d2f890a4c1e6b7d9350f28
